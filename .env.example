# Create a bot with Telegram's official BotFather and paste the token here.
# Never commit your real .env file or share your bot token.
BOT_TOKEN=replace-with-your-botfather-token

# Private by default. First start the bot and send /myid, then add your numeric
# Telegram user ID here and restart. Multiple IDs can be comma-separated.
ALLOWED_USER_IDS=
ALLOW_ALL_USERS=false

# Telegram's hosted Bot API permits downloads up to 20 MB.
MAX_UPLOAD_MB=19
MAX_UNCOMPRESSED_MB=256
MAX_ARCHIVE_ENTRIES=50000
TEMP_DIR=/tmp/apk-telegram-bot
